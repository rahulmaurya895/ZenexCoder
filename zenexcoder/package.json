{
  "name": "zenexcoder",
  "version": "1.0.0",
  "description": "AI-Powered Developer Environment",
  "author": "Raahool Mauryaa (Independent Developer)",
  "license": "MIT",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:clean": "node scripts/clean-build.mjs && electron-vite build",
    "dist:clean": "node scripts/clean-build.mjs && electron-builder",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.22.0",
    "@aws-sdk/client-sts": "^3.1068.0",
    "@google/generative-ai": "^0.12.0",
    "@jimp/core": "1.6.1",
    "@jimp/diff": "1.6.1",
    "@jimp/js-bmp": "1.6.1",
    "@jimp/js-gif": "1.6.1",
    "@jimp/js-jpeg": "1.6.1",
    "@jimp/js-png": "1.6.1",
    "@jimp/js-tiff": "1.6.1",
    "@jimp/plugin-blit": "1.6.1",
    "@jimp/plugin-blur": "1.6.1",
    "@jimp/plugin-circle": "1.6.1",
    "@jimp/plugin-color": "1.6.1",
    "@jimp/plugin-contain": "1.6.1",
    "@jimp/plugin-cover": "1.6.1",
    "@jimp/plugin-crop": "1.6.1",
    "@jimp/plugin-displace": "1.6.1",
    "@jimp/plugin-dither": "1.6.1",
    "@jimp/plugin-fisheye": "1.6.1",
    "@jimp/plugin-flip": "1.6.1",
    "@jimp/plugin-hash": "1.6.1",
    "@jimp/plugin-mask": "1.6.1",
    "@jimp/plugin-print": "1.6.1",
    "@jimp/plugin-quantize": "1.6.1",
    "@jimp/plugin-resize": "1.6.1",
    "@jimp/plugin-rotate": "1.6.1",
    "@jimp/plugin-threshold": "1.6.1",
    "@jimp/types": "1.6.1",
    "@jimp/utils": "1.6.1",
    "@lancedb/vectordb-win32-x64-msvc": "0.21.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.6.0",
    "@nut-tree-fork/default-clipboard-provider": "^4.2.6",
    "@nut-tree-fork/libnut": "^4.2.6",
    "@nut-tree-fork/libnut-win32": "^2.7.5",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@nut-tree-fork/provider-interfaces": "^4.2.6",
    "@nut-tree-fork/shared": "^4.2.6",
    "@octokit/rest": "^22.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "apache-arrow": "^14.0.2",
    "axios": "^1.7.2",
    "better-sqlite3": "^11.0.0",
    "bmp-ts": "^1.0.9",
    "bonjour-service": "^1.4.1",
    "clsx": "^2.1.1",
    "conf": "14.0.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "^3.1.5",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "highlight.js": "^11.10.0",
    "https-proxy-agent": "5.0.1",
    "isexe": "2.0.0",
    "jimp": "^1.6.1",
    "json-schema-traverse": "1.0.0",
    "lucide-react": "^0.383.0",
    "monaco-editor": "^0.50.0",
    "node-pty": "^1.1.0",
    "openai": "^4.47.0",
    "path-key": "3.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "playwright-core": "1.60.0",
    "pngjs": "^7.0.0",
    "proxy-from-env": "2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "require-from-string": "2.0.2",
    "shebang-command": "2.0.0",
    "shebang-regex": "3.0.0",
    "tailwind-merge": "^2.3.0",
    "vectordb": "^0.21.2",
    "vercel": "^58.9.0",
    "which": "2.0.2",
    "ws": "^8.21.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.38",
    "prebuild-install": "^7.1.3",
    "tailwindcss": "^3.4.4",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.zenexcoder.app",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "productName": "ZenexCoder",
    "directories": {
      "output": "dist"
    },
    "extraMetadata": {
      "main": "out/main/main.js"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "scripts/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@jimp/**/*",
      "node_modules/@nut-tree-fork/**/*",
      "node_modules/cross-spawn/**/*",
      "node_modules/isexe/**/*",
      "node_modules/jimp/**/*",
      "node_modules/path-key/**/*",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/shebang-command/**/*",
      "node_modules/shebang-regex/**/*",
      "node_modules/vectordb/**/*",
      "node_modules/@lancedb/**/*",
      "node_modules/which/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
